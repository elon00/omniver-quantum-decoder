{
  "schema": 2,
  "permissions": ["tools.invoke"],
  "required_executas": [
    {
      "tool_id": "bundled:omniver-quantum-decoder",
      "min_version": "2.5.0",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "host_capabilities": ["llm.sample"],
  "system_prompt_addendum": "The user has the Omniver Quantum Decoder app open. It provides small-integer Shor-style order-finding simulation and an Anna-host quantum copilot through its bundled Executa. Treat all simulator results as educational simulations; never claim that a real cryptographic key has been recovered unless independently verified on real authorized data.",
  "tags": ["quantum", "shor-algorithm", "post-quantum", "cryptography", "bitcoin", "solana", "executa", "sampling"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Omniver Quantum Decoder",
        "default": true,
        "entry": "index.html",
        "default_size": { "w": 1100, "h": 760 },
        "min_size": { "w": 380, "h": 520 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:bundled:omniver-quantum-decoder"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
